<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Debrief & Survey | Sombra Technologies</title>

    <link rel="stylesheet" href="/css/ctf-survey.css">
</head>
<body>

<nav class="navbar">
    <a href="/" class="brand">SOMBRA</a>
    <div class="nav-right">
        <a href="/">Corporate Portal</a>
        <a href="/directory">Directory</a>
        <a href="/ctf">Security Operations</a>
    </div>
</nav>

<main class="container">

    <div class="eyebrow">Sombra Technologies / After-Action Report</div>
    <h1>End Game Debrief & Survey</h1>
    <p class="subtitle">
        Thank you for participating in the Security Operations exercise. 
        Complete this after-action survey to help the Gamemaster evaluate challenge balance, 
        infrastructure stability, and overall exercise quality.
    </p>

    <% if (locals.submitted) { %>
        <div class="notice correct">
            ✓ After-action report logged. Thank you for your feedback!
        </div>
    <% } %>

    <!-- Session Summary Cards -->
    <div class="stats">
        <div class="stat-card">
            <div class="stat-label">Participant Team</div>
            <div class="stat-value"><%= teamName || "Unassigned" %></div>
        </div>

        <div class="stat-card">
            <div class="stat-label">Final Score</div>
            <div class="stat-value highlight"><%= teamScore ? teamScore.points : 0 %> PTS</div>
        </div>

        <div class="stat-card">
            <div class="stat-label">Exercise Gamemaster</div>
            <div class="stat-value"><%= gamemaster.name || "Command" %></div>
        </div>
    </div>

    <!-- Survey Form -->
    <section class="survey-panel">
        <form action="/ctf/end-game" method="POST" id="debrief-form">
            <input type="hidden" name="teamName" value="<%= teamName %>">
            <input type="hidden" name="score" value="<%= teamScore ? teamScore.points : 0 %>">

            <!-- 1. Overall Experience Rating -->
            <div class="form-group">
                <label class="form-label">1. Overall Exercise Rating</label>
                <span class="form-hint">How would you rate your team's overall experience during the CTF?</span>
                <div class="rating-group">
                    <div class="rating-option">
                        <input type="radio" id="rate-1" name="overallRating" value="1" required>
                        <label for="rate-1">1<span>Poor</span></label>
                    </div>
                    <div class="rating-option">
                        <input type="radio" id="rate-2" name="overallRating" value="2">
                        <label for="rate-2">2<span>Fair</span></label>
                    </div>
                    <div class="rating-option">
                        <input type="radio" id="rate-3" name="overallRating" value="3">
                        <label for="rate-3">3<span>Good</span></label>
                    </div>
                    <div class="rating-option">
                        <input type="radio" id="rate-4" name="overallRating" value="4">
                        <label for="rate-4">4<span>Great</span></label>
                    </div>
                    <div class="rating-option">
                        <input type="radio" id="rate-5" name="overallRating" value="5">
                        <label for="rate-5">5<span>Elite</span></label>
                    </div>
                </div>
            </div>
            <!-- 2. Challenge Difficulty Balance -->
            <div class="form-group">
                <label class="form-label">2. Challenge Difficulty Balance</label>
                <span class="form-hint">How did the technical difficulty align with your skill level?</span>
                <div class="rating-group">
                    <div class="rating-option">
                        <input type="radio" id="diff-1" name="difficultyBalance" value="1" required>
                        <label for="diff-1">1<span>Too Easy — Solved everything quickly</span></label>
                    </div>
                    <div class="rating-option">
                        <input type="radio" id="diff-2" name="difficultyBalance" value="2">
                        <label for="diff-2">2<span>Well Balanced — Good mix of entry and advanced tasks</span></label>
                    </div>
                    <div class="rating-option">
                        <input type="radio" id="diff-3" name="difficultyBalance" value="3">
                        <label for="diff-3">3<span>Challenging — Required significant effort and hints</span></label>
                    </div>
                    <div class="rating-option">
                        <input type="radio" id="diff-4" name="difficultyBalance" value="4">
                        <label for="diff-4">4<span>Too Hard — Felt stuck on most objectives</span></label>
                    </div>
                    <div class="rating-option">
                        <input type="radio" id="diff-5" name="difficultyBalance" value="5">
                        <label for="diff-5">5<span>Extremely Hard — Felt overwhelmed by the difficulty</span></label>
                    </div>
                </div>
            </div>
            <!-- 3. Favorite Challenge & Why -->
            <div class="form-group">
                <label class="form-label">3. Favorite Challenge & Why</label>
                <span class="form-hint">Which objective was the most fun or educational to solve?</span>
                <textarea class="form-control" id="favoriteChallenge" name="favoriteChallenge" rows="4" required></textarea>
            </div>
            <!-- 4. Technical Issues, Bugs, or Suggestions -->
            <div class="form-group">
                <label class="form-label">4. Technical Issues, Bugs, or Suggestions</label>
                <span class="form-hint">Did you encounter any broken endpoints, unclear objectives, or downtime?</span>
                <textarea class="form-control" id="technicalIssues" name="technicalIssues" rows="4" required></textarea>
            </div>
            <!-- 5. Overall Rating -->
            <div class="form-group">
                <label class="form-label">5. Overall Rating</label>
                <span class="form-hint">How would you rate the overall experience of the CTF exercise?</span>
                <div class="rating-group">
                    <div class="rating-option">
                        <input type="radio" id="overall-1" name="overallRating" value="1" required>
                        <label for="overall-1">1<span>Poor — Did not enjoy the experience</span></label>
                    </div>
                    <div class="rating-option">
                        <input type="radio" id="overall-2" name="overallRating" value="2">
                        <label for="overall-2">2<span>Fair — Some aspects were enjoyable</span></label>
                    </div>
                    <div class="rating-option">
                        <input type="radio" id="overall-3" name="overallRating" value="3">
                        <label for="overall-3">3<span>Good — Enjoyed the experience overall</span></label>
                    </div>
                    <div class="rating-option">
                        <input type="radio" id="overall-4" name="overallRating" value="4">
                        <label for="overall-4">4<span>Great — Highly enjoyable and educational</span></label>
                    </div>
                    <div class="rating-option">
                        <input type="radio" id="overall-5" name="overallRating" value="5">
                        <label for="overall-5">5<span>Elite — Exceptional experience</span></label>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Submit Survey</button>
        </form>
    </body>
</html>
