<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Security Operations | Sombra Technologies</title>

    <link rel="stylesheet" href="/css/ctf.css">
</head>

<body>
<div id="reverse-overlay" hidden>
    <div class="reverse-interlock">
        <p class="eyebrow">BLUE TEAM COUNTERMEASURE</p>
        <h2 id="reverse-overlay-title">Portal Interference</h2>
        <p id="reverse-overlay-copy">Complete the verification to restore access.</p>
        <div id="captcha-panel" hidden>
            <code id="captcha-code"></code>
            <input id="captcha-answer" maxlength="6" placeholder="Enter code" autocomplete="off">
            <button id="captcha-submit" type="button">Verify & Restore</button>
        </div>
        <p id="reverse-countdown"></p>
    </div>
</div>
<div id="watch-indicator" <%= gamemaster.watchMode ? "" : "hidden" %>>
    BLUE TEAM TELEMETRY ACTIVE
</div>
<div id="incident-banner" <%= gamemaster.incidentMode ? "" : "hidden" %>>
    INCIDENT RESPONSE IN PROGRESS — EXERCISE STATUS: ACTIVE
</div>
<div id="broadcast-banner" <%= gamemaster.banner ? "" : "hidden" %>>
    <%= gamemaster.banner %>
</div>
<div id="end-game" <%= gamemaster.gameEnded ? "" : "hidden" %>>
    <h2>End Game</h2>
    <p>The game has ended. No further submissions are allowed.</p>
    <a href="/ctf/end-game" class="button">End Game Survey</a>
</div>

<nav class="navbar">
    <a href="/" class="brand">SOMBRA</a>

    <div class="nav-right">
        <a href="/">Corporate Portal</a>
        <a href="/directory">Directory</a>
        <a href="/ctf">Security Operations</a>
    </div>
</nav>

<main class="container">

    <div class="eyebrow">Sombra Technologies / Security Division</div>

    <h1>Security Operations Center</h1>

    <p class="subtitle">
        Investigate security incidents, identify weaknesses in internal
        infrastructure, and demonstrate your technical capabilities.
        Every discovery brings you closer to understanding the incident.
    </p>

    <% if (status === "correct") { %>
        <div class="notice correct">
            ✓ Correct flag. Challenge completed and points awarded.
        </div>
    <% } else if (status === "incorrect") { %>
        <div class="notice incorrect">
            ✕ Incorrect flag. Review your findings and try again.
        </div>
    <% } else if (status === "already-solved") { %>
        <div class="notice warning">
            This team has already completed that challenge.
        </div>
    <% } else if (status === "invalid") { %>
        <div class="notice warning">
            Please enter a valid flag.
        </div>
    <% } else if (status === "frozen") { %>
        <div class="notice warning">
            Submissions are currently paused by Blue Team.
        </div>
    <% } else if (status === "captcha") { %>
        <div class="notice warning">
            A Blue Team CAPTCHA is required before submissions are restored.
        </div>
    <% } else if (status === "throttled") { %>
        <div class="notice warning">
            Submission throttle active: wait until the reverse attack expires.
        </div>
    <% } %>

    <div class="rules" id="rules">
        <h3>Rules</h3>
        <ul>
            <li>Submit flags to earn points.</li>
            <li>Do not share flags with other teams.</li>
            <li>No flags are in the /ctf/ directory.</li>
            <li>Do not cheat or exploit vulnerabilities outside the scope of the challenges.</li>
            <li>Do not attempt to access other teams' data, accounts, or systems.</li>
            <li>If you encounter any issues or uncertainties, contact the organizers for clarification.</li>
        </ul>
    </div>

    <div class="notice warning" id="freeze-notice" <%= gamemaster.freezeMode ? "" : "hidden" %>>
        CHALLENGE FREEZE ACTIVE: flag submissions are paused.
    </div>

    <div class="stats">

        <div class="stat-card">
            <div class="stat-label">Available Challenges</div>
            <div id="available-challenges" class="stat-value"><%= challenges.length %></div>
        </div>

        <div class="stat-card">
            <div class="stat-label">Challenges Solved</div>
            <div id="solved-challenges" class="stat-value"><%= solvedIds.length %></div>
        </div>

        <div class="stat-card">
            <div class="stat-label">Your Score</div>
            <div id="team-score" class="stat-value">
                <%= teamScore ? teamScore.points : 0 %>
            </div>
        </div>

    </div>

    <section class="team-panel">
        <div class="eyebrow">Participant Identification</div>
        <h2><%= participant ? "Participant Session" : "Sign In" %></h2>

        <% if (participant) { %>
            <p class="subtitle">
                Signed in as <strong><%= participant.username %></strong> on
                <strong><%= participant.team_name %></strong>.
            </p>
            <% if (teamScore) { %>
                <p class="subtitle">
                    <%= teamScore.solved %> challenges completed,
                    <%= teamScore.points %> points.
                </p>
            <% } %>
            <form action="/ctf/logout" method="POST">
                <button type="submit">Sign Out</button>
            </form>
        <% } else { %>
            <p class="subtitle">Sign in with a participant account, or register a new account and team.</p>
            <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; max-width: 700px;">
                <form action="/ctf/login" method="POST" style="display:flex; flex-direction:column;">
                    <input type="text" name="username" placeholder="Username" maxlength="32" required>
                    <input type="password" name="password" placeholder="Password" maxlength="128" required>
                    <button type="submit">Sign In</button>
                </form>
                <form action="/ctf/register" method="POST" style="display:flex; flex-direction:column;">
                    <input type="text" name="username" placeholder="New username" maxlength="32" required>
                    <input type="password" name="password" placeholder="New password (8+ characters)" maxlength="128" required>
                    <input type="text" name="teamName" placeholder="Team name" maxlength="32" required>
                    <button type="submit">Create Account</button>
                </form>
            </div>
        <% } %>
    </section>

    <div class="section-heading">
        <h2>Available Challenges</h2>
        <span>FLAG FORMAT: SOMBRA{...}</span>
    </div>

    <div class="challenge-grid">

        <% challenges.forEach((challenge, index) => { %>

            <% const isSolved = solvedIds.includes(challenge.id); %>

            <article
                class="challenge-card <%= isSolved ? 'solved' : '' %>"
                data-challenge-id="<%= challenge.id %>"
            >

                <div class="challenge-top">
                    <span class="category">
                        <%= challenge.category %>
                    </span>

                    <span class="points">
                        <%= gamemaster.handicapMode ? Math.floor(challenge.points / 2) : challenge.points %> PTS<% if (gamemaster.handicapMode) { %><span class="handicap-tag">HANDICAP</span><% } %>
                    </span>
                </div>

                <h3>
                    <%= String(index + 1).padStart(2, "0") %>.
                    <%= challenge.name %>
                </h3>

                <p class="challenge-description">
                    <%= challenge.description %>
                </p>

                <div class="objective">
                    <strong>OBJECTIVE</strong><br>
                    <%= challenge.objective %>
                </div>

                <% if (isSolved) { %>

                    <div class="solved-label">
                        ✓ COMPLETED
                    </div>

                <% } else { %>

                    <form
                        action="/ctf/submit"
                        method="POST"
                        class="flag-form"
                    >
                        <input type="hidden" name="reverseProof" value="<%= gamemaster.reverseNonce %>">

                        <input
                            type="hidden"
                            name="challengeId"
                            value="<%= challenge.id %>"
                        >

                        <input
                            type="text"
                            name="flag"
                            placeholder="SOMBRA{...}"
                            autocomplete="off"
                            required
                        >

                        <button type="submit" <%= (!teamName || gamemaster.freezeMode) ? "disabled" : "" %>>
                            Submit Flag
                        </button>

                    </form>

                    <% if (!teamName) { %>
                        <p class="subtitle">
                            Load a team profile before submitting flags.
                        </p>
                    <% } %>

                <% } %>

                <% if (challenge.hints && challenge.hints.length) { %>
                    <details>
                        <summary>View Hints</summary>

                        <ol>
                            <% challenge.hints.forEach(hint => { %>
                                <li><%= hint %></li>
                            <% }) %>
                        </ol>
                    </details>
                <% } %>

            </article>

        <% }) %>

    </div>

    <% const initialRoutes = locals.routes || []; %>
    <section id="routes-section" <%= (gamemaster.showRoutes && initialRoutes.length) ? "" : "hidden" %>>
        <div class="section-heading">
            <h2>Known Routes</h2>
            <span>PROVIDED BY BLUE TEAM</span>
        </div>

        <div class="routes-panel" id="routes-list">
            <% initialRoutes.forEach(route => { %>
                <div class="route-row">
                    <span class="route-methods"><%= route.methods.join(", ") %></span>
                    <code><%= route.path %></code>
                </div>
            <% }) %>
        </div>
    </section>

    <section>
        <div class="section-heading">
            <h2>Team Leaderboard</h2>
            <span>TOP 10 TEAMS</span>
        </div>

        <table class="leaderboard">
            <thead>
                <tr>
                    <th>Rank</th>
                    <th>Team</th>
                    <th>Challenges</th>
                    <th>Points</th>
                </tr>
            </thead>

            <tbody id="leaderboard-body">

                <% if (leaderboard.length === 0) { %>

                    <tr>
                        <td colspan="4">No teams have scored yet.</td>
                    </tr>

                <% } %>

                <% leaderboard.forEach((team, index) => { %>

                    <tr>
                        <td>#<%= index + 1 %></td>
                        <td><%= team.teamName %></td>
                        <td><%= team.solved %></td>
                        <td><%= team.points %></td>
                    </tr>

                <% }) %>

            </tbody>
        </table>
    </section>

</main>

<footer>
    SOMBRA TECHNOLOGIES · SECURITY OPERATIONS
    <span class="footer-label">INTERNAL TRAINING ENVIRONMENT</span>
</footer>

<script src="/js/ctf-live.js"></script>
</body>
</html>
