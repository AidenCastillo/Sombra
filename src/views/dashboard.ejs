
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Sombra Technologies | Employee Portal</title>

    <link rel="stylesheet" href="/css/app.css">
</head>

<body>

<div class="archive">

    <header>
        <h2>SOMBRA TECHNOLOGIES</h2>
        <small>EMPLOYEE WORKSPACE</small>
        <div style="float:right;margin-top:-42px;text-align:right">
            <small>SESSION ROLE: <strong><%= role %></strong></small>
            <form method="POST" action="/logout" style="margin-top:8px">
                <button type="submit" style="border:1px solid #a8bdd4;background:transparent;color:white;padding:6px 10px">Log out</button>
            </form>
        </div>
    </header>

    <main>

        <p class="label">INTERNAL EMPLOYEE PORTAL</p>

        <h1>Welcome to Sombra Technologies</h1>

        <p>
            Your central location for company resources,
            employee information, and IT services.
        </p>

        <hr>

        <h3>Company Overview</h3>

        <p>
            Active employees:
            <strong><%= employeeCount %></strong>
        </p>

        <h3>Departments</h3>

        <% departments.forEach(department => { %>

            <div class="file">

                <div>
                    <strong><%= department.name %></strong>

                    <small>
                        <%= department.description %>
                    </small>
                </div>

            </div>

        <% }) %>

        <h3>Workspace Navigation</h3>

        <p>
            <a href="/directory">Employee Directory</a>
        </p>

        <p>
            <a href="/api/documents">Company Documents</a>
        </p>

        <p>
            <a href="/employee/admin">Administration Console</a>
        </p>

        <p>
            <a href="/employee/news">Company News</a>
        </p>

        <hr>

        <small>
            Browser training state:
            <code id="browser-role">Loading...</code>
        </small>

    </main>

</div>

<script>
    const storedAuth = JSON.parse(
        localStorage.getItem("sombra_auth") || '{"role":"basic"}'
    );
    document.getElementById("browser-role").textContent =
        "role:" + (storedAuth.role || "basic");
</script>

</body>
</html>
