<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Internal Documents</title><link rel="stylesheet" href="/css/app.css"></head>
<body><main><h1>Internal Documents</h1>
<% documents.forEach(document => { %><article><h2><a href="/documents/<%= document.id %>"><%= document.title %></a></h2><p><%= document.summary %></p></article><% }) %>
<p><a href="/documents/upload">Upload a document</a></p></main></body></html>
