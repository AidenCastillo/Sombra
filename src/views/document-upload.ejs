<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Document Processing | Sombra Corp</title>
        <link rel="stylesheet" href="/css/app.css" />
    </head>
    <body>
        <h1>Corporate Document Processing</h1>

        <p>Upload PDF documents for automated indexing and processing.</p>

        <form
            action="/api/documents/upload"
            method="POST"
            enctype="multipart/form-data"
        >
            <input type="file" name="document" accept=".pdf" required />

            <button type="submit">Upload Document</button>
        </form>

        <div id="result"></div>
    </body>
</html>
