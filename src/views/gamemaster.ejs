<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Blue Team | Game Master</title>
    <link rel="stylesheet" href="/css/gamemaster.css">
</head>
<body>
    <aside class="sidebar">
        <div class="console-brand">
            <div class="brand-mark">BT</div>
            <div>
                <strong>BLUE TEAM</strong>
                <small>GAME MASTER</small>
            </div>
        </div>

        <nav>
            <a class="active" href="#overview">Overview</a>
            <a href="#reverse_attack">Reverse Attacks</a>
            <a href="#participants">Participants</a>
            <a href="#teams">Teams</a>
            <a href="#challenges">Challenges</a>
            <a href="#broadcast">Broadcast</a>
            <a href="#game_control">Game Control</a>
        </nav>

        <div class="operator-status">
            <span class="status-dot"></span>
            <div>
                <strong>OPERATOR ACTIVE</strong>
                <small>SESSION SECURED</small>
            </div>
        </div>
    </aside>

    <main class="console" id="overview">
        <header class="topbar">
            <div>
                <p class="eyebrow">OPERATION COMMAND</p>
                <h1>Exercise Control</h1>
            </div>
            <form method="POST" action="/gamemaster/logout">
                <button class="logout-button" type="submit">Terminate session</button>
            </form>
        </header>

        <section class="status-grid">
            <article class="metric">
                <small>ACTIVE PARTICIPANTS</small>
                <strong><%= activeParticipantCount %></strong>
            </article>
            <article class="metric">
                <small>REGISTERED TEAMS</small>
                <strong><%= teams.length %></strong>
            </article>
            <article class="metric">
                <small>CHALLENGES</small>
                <strong><%= challenges.filter(c => c.active).length %>/<%= challenges.length %></strong>
            </article>
            <article class="metric">
                <small>BLUE TEAM STATE</small>
                <strong class="metric-live"><%= state.incidentMode ? "INCIDENT" : "STANDBY" %></strong>
            </article>
        </section>

        <section class="console-grid">
            <article class="panel" id="broadcast">
                <div class="panel-heading">
                    <div>
                        <p class="eyebrow">LIVE INFLUENCE</p>
                        <h2>Portal Presence</h2>
                    </div>
                    <span class="live-tag">LIVE</span>
                </div>

                <form method="POST" action="/gamemaster/mode" class="mode-form">
                    <label class="toggle-row">
                        <span>
                            <strong>Incident response mode</strong>
                            <small>Display a blue-team status banner</small>
                        </span>
                        <input type="checkbox" name="incidentMode" value="1" <%= state.incidentMode ? "checked" : "" %>>
                    </label>
                    <label class="toggle-row">
                        <span>
                            <strong>Telemetry indicator</strong>
                            <small>Make teams feel observed from the corner of the page</small>
                        </span>
                        <input type="checkbox" name="watchMode" value="1" <%= state.watchMode ? "checked" : "" %>>
                    </label>
                    <button type="submit" class="primary-button">Apply presence state</button>
                </form>

                <form method="POST" action="/gamemaster/broadcast" class="broadcast-form">
                    <label for="banner">Public message</label>
                    <div>
                        <input id="banner" name="banner" maxlength="200" value="<%= state.banner %>" placeholder="Authorized activity detected...">
                        <button type="submit">Broadcast</button>
                    </div>
                </form>
            </article>

            <article class="panel" id="game_control">
                <div class="panel-heading">
                    <div>
                        <p class="eyebrow">GAME CONTROL</p>
                        <h2>Game Control</h2>
                    </div>
                </div>

                <form method="POST" action="/gamemaster/game_control" class="mode-form">
                    <label class="toggle-row">
                        <span>
                            <strong>Challenge handicap</strong>
                            <small>Reduce the point value of all challenges by 50%</small>
                        </span>
                        <input type="checkbox" name="handicapMode" value="1" <%= state.handicapMode ? "checked" : "" %>>
                    </label>
                    <label class="toggle-row">
                        <span>
                            <strong>Challenge freeze</strong>
                            <small>Prevent teams from submitting any challenges</small>
                        </span>
                        <input type="checkbox" name="freezeMode" value="1" <%= state.freezeMode ? "checked" : "" %>>
                    </label>
                    <label class="toggle-row">
                        <span>
                            <strong>Show all routes</strong>
                            <small>Reveal all challenge routes to teams</small>
                        </span>
                        <input type="checkbox" name="showRoutes" value="1" <%= state.showRoutes ? "checked" : "" %>>
                    </label>
                    <button type="submit" class="primary-button">Apply challenge state</button>
                </form>
            </article>

            <article class="panel" id="reverse_attack">
                <div class="panel-heading">
                    <div>
                        <p class="eyebrow">TARGETED COUNTERMEASURE</p>
                        <h2>Reverse Attack</h2>
                    </div>
                    <% if (state.reverseEffect !== "none" && state.reverseUntil > Date.now()) { %>
                        <span class="live-tag">ACTIVE</span>
                    <% } else { %>
                        <span class="live-tag" style="color: var(--muted); border-color: var(--line);">STANDBY</span>
                    <% } %>
                </div>
                <form method="POST" action="/gamemaster/reverse_attack" class="reverse-attack-form">
                    <label for="reverse-team">Target team</label>
                    <select id="reverse-team" name="teamId" required>
                        <option value="">Select team...</option>
                        <% teams.forEach(team => { %>
                            <option value="<%= team.id %>" <%= state.reverseTeamId === team.id ? "selected" : "" %>>
                                <%= team.team_name %> · <%= team.points %> pts
                            </option>
                        <% }) %>
                    </select>

                    <label for="reverse-effect">Slow-down effect</label>
                    <select id="reverse-effect" name="effect">
                        <option value="captcha" <%= state.reverseEffect === "captcha" ? "selected" : "" %>>Hard CAPTCHA challenge</option>
                        <option value="scramble" <%= state.reverseEffect === "scramble" ? "selected" : "" %>>Scramble portal screen</option>
                        <option value="throttle" <%= state.reverseEffect === "throttle" ? "selected" : "" %>>Submission throttle</option>
                        <option value="blackout" <%= state.reverseEffect === "blackout" ? "selected" : "" %>>Portal blackout</option>
                    </select>

                    <label for="reverse-duration">Duration</label>
                    <select id="reverse-duration" name="duration">
                        <option value="30">30 seconds</option>
                        <option value="60" selected>1 minute</option>
                        <option value="120">2 minutes</option>
                        <option value="300">5 minutes</option>
                    </select>

                    <button type="submit" class="primary-button">Deploy reverse attack</button>
                </form>
                <form method="POST" action="/gamemaster/reverse_attack" class="reverse-clear-form">
                    <input type="hidden" name="effect" value="none">
                    <button type="submit" class="danger-action">Clear active effect</button>
                </form>
            </article>

            <article class="panel" id="challenges">
                <div class="panel-heading">
                    <div>
                        <p class="eyebrow">OBJECTIVE CONTROL</p>
                        <h2>Challenge Visibility</h2>
                    </div>
                </div>
                <div class="challenge-list">
                    <% challenges.forEach(challenge => { %>
                        <div class="challenge-row">
                            <div>
                                <strong><%= challenge.title %></strong>
                                <small><%= challenge.category %> · <%= challenge.points %> pts</small>
                            </div>
                            <form method="POST" action="/gamemaster/challenge">
                                <input type="hidden" name="challengeId" value="<%= challenge.id %>">
                                <input type="hidden" name="active" value="<%= challenge.active ? "0" : "1" %>">
                                <button class="<%= challenge.active ? "active-button" : "inactive-button" %>" type="submit">
                                    <%= challenge.active ? "Enabled" : "Disabled" %>
                                </button>
                            </form>
                        </div>
                    <% }) %>
                </div>
            </article>
            
            
            <article class="panel" id="end-game">
                    <div class="panel-heading">
                        <div>
                            <p class="eyebrow">GAME END</p>
                            <h2>End Game</h2>
                        </div>
                    </div>
                    <div class="end-game-list">
                        <form method="POST" action="/gamemaster/end-game">
                            <% if (state.gameEnded === true) { %>
                                <button class="danger-action" type="submit">Resume Game</button>
                            <% } %>
                            <% if (state.gameEnded === false) { %>
                                <button class="danger-action" type="submit">End Game</button>
                            <% } %>
                        </form>
                    </div>
            </article>
    </section>

        <section class="console-grid lower-grid">
            <article class="panel" id="participants">
                <div class="panel-heading">
                    <div>
                        <p class="eyebrow">LIVE PARTICIPANTS</p>
                        <h2>Active Users</h2>
                    </div>
                    <span class="live-tag"><%= activeParticipantCount %> ACTIVE</span>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr><th>Username</th><th>Team</th><th>Score</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            <% participants.forEach(participant => { %>
                                <tr>
                                    <td><strong><%= participant.username %></strong></td>
                                    <td><%= participant.team_name %></td>
                                    <td><span class="score"><%= participant.points %></span></td>
                                    <td><span class="<%= participant.is_active ? "team-enabled" : "team-disabled" %>"><%= participant.is_active ? "Active" : "Offline" %></span></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                    <% if (!participants.length) { %><p class="empty-state">No registered participants yet.</p><% } %>
                </div>
            </article>

            <article class="panel" id="teams">
                <div class="panel-heading">
                    <div>
                        <p class="eyebrow">PARTICIPANT CONTROL</p>
                        <h2>Team Roster</h2>
                    </div>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr><th>Team</th><th>Score</th><th>State</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            <% teams.forEach(team => { %>
                                <tr>
                                    <td><strong><%= team.team_name %></strong></td>
                                    <td><span class="score"><%= team.points %></span></td>
                                    <td><span class="<%= team.active ? "team-enabled" : "team-disabled" %>"><%= team.active ? "Active" : "Disabled" %></span></td>
                                    <td class="team-actions">
                                        <form method="POST" action="/gamemaster/team">
                                            <input type="hidden" name="teamId" value="<%= team.id %>">
                                            <input type="hidden" name="action" value="<%= team.active ? "deactivate" : "activate" %>">
                                            <button type="submit"><%= team.active ? "Disable" : "Enable" %></button>
                                        </form>
                                        <form method="POST" action="/gamemaster/team" onsubmit="return confirm('Reset all scores and attempts for this team?')">
                                            <input type="hidden" name="teamId" value="<%= team.id %>">
                                            <input type="hidden" name="action" value="reset">
                                            <button class="danger-action" type="submit">Reset</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                    <% if (!teams.length) { %><p class="empty-state">No registered teams yet.</p><% } %>
                </div>
            </article>

            <article class="panel">
                <div class="panel-heading">
                    <div>
                        <p class="eyebrow">ACTIVITY FEED</p>
                        <h2>Recent Attempts</h2>
                    </div>
                </div>
                <div class="attempt-list">
                    <% attempts.forEach(attempt => { %>
                        <div class="attempt-row">
                            <span class="<%= attempt.is_correct ? "attempt-ok" : "attempt-bad" %>"></span>
                            <div>
                                <strong><%= attempt.team_name %></strong>
                                <small><%= attempt.challenge_title %></small>
                            </div>
                            <time><%= attempt.submitted_at %></time>
                        </div>
                    <% }) %>
                    <% if (!attempts.length) { %><p class="empty-state">No submissions recorded.</p><% } %>
                </div>
            </article>
        </section>
    </main>
</body>
</html>
