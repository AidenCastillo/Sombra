<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sombra Technologies</title>
    <link rel="stylesheet" href="/css/public.css">
</head>
<body>
    <header class="site-header">
        <a class="brand" href="/">
            <span class="brand-mark">S</span>
            <span>SOMBRA <small>TECHNOLOGIES</small></span>
        </a>
        <nav>
            <a href="#solutions">Solutions</a>
            <a href="#company">Company</a>
            <a href="#careers">Careers</a>
            <a href="/ctf">Operations</a>
            <a class="login-button" href="/login">Employee login</a>
        </nav>
    </header>

    <main>
        <section class="hero">
            <div class="hero-copy">
                <p class="eyebrow">ENGINEERING TRUST AT SCALE</p>
                <h1>Secure infrastructure for a changing world.</h1>
                <p class="hero-description">
                    Sombra Technologies designs resilient platforms, operational
                    systems, and secure digital services for organizations that
                    cannot afford to stand still.
                </p>
                <div class="hero-actions">
                    <a class="primary-action" href="#solutions">Explore solutions</a>
                    <a class="text-action" href="#company">Meet Sombra <span>→</span></a>
                </div>
            </div>

            <div class="hero-visual" aria-label="Sombra network visualization">
                <div class="grid-glow"></div>
                <div class="orbit orbit-one"></div>
                <div class="orbit orbit-two"></div>
                <div class="node node-a"></div>
                <div class="node node-b"></div>
                <div class="node node-c"></div>
                <div class="core">
                    <span>SOMBRA</span>
                    <small>NETWORK</small>
                </div>
            </div>
        </section>

        <section class="capabilities" id="solutions">
            <article>
                <span>01</span>
                <h2>Cloud Infrastructure</h2>
                <p>Reliable architectures built for continuity, control, and scale.</p>
            </article>
            <article>
                <span>02</span>
                <h2>Security Operations</h2>
                <p>Proactive monitoring and response across complex environments.</p>
            </article>
            <article>
                <span>03</span>
                <h2>Enterprise Platforms</h2>
                <p>Purpose-built systems that help distributed teams move faster.</p>
            </article>
        </section>

        <section class="company-section" id="company">
            <p class="eyebrow">THE SOMBRA STANDARD</p>
            <h2>Built on discipline.<br>Focused on what comes next.</h2>
            <p>
                From Austin to teams around the world, Sombra brings engineering,
                operations, and security together under one mission.
            </p>
        </section>
    </main>

    <footer>
        <div class="brand footer-brand">
            <span class="brand-mark">S</span>
            <span>SOMBRA <small>TECHNOLOGIES</small></span>
        </div>
        <p>© 2026 Sombra Technologies. Corporate systems are for authorized use.</p>
    </footer>
</body>
</html>
